# Prisma Dev(로컬): `npm run db:dev` 후 출력된 URL을 사용
# Docker: postgresql://postgres:postgres@localhost:5432/sourcing_hub?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sourcing_hub?schema=public"

# 가격 규칙 기본값 (시드/폴백)
USD_TO_KRW=1380
MARGIN_RATE=0.20
SHIPPING_FEE_KRW=15000
AGENCY_FEE_KRW=3000
PLATFORM_FEE_RATE=0.10
DUTY_RATE=0.08

# --- 스마트스토어 Commerce API ---
# CLIENT_ID/SECRET 미설정 시 스텁 등록
SMARTSTORE_CLIENT_ID=
SMARTSTORE_CLIENT_SECRET=
# SELF(기본, 본인 스토어) | SELLER(솔루션 — SMARTSTORE_ACCOUNT_ID 필요)
SMARTSTORE_TOKEN_TYPE=SELF
SMARTSTORE_ACCOUNT_ID=
# 상품 등록에 필요 (키만 있고 아래가 없으면 live 모드에서 실패 메시지 반환)
SMARTSTORE_LEAF_CATEGORY_ID=
SMARTSTORE_SHIPPING_ADDRESS_ID=
SMARTSTORE_RETURN_ADDRESS_ID=
SMARTSTORE_DELIVERY_ATTRIBUTE_TYPE=NORMAL
SMARTSTORE_DELIVERY_FEE_TYPE=FREE
SMARTSTORE_DELIVERY_FEE=0
SMARTSTORE_RETURN_DELIVERY_FEE=3000
SMARTSTORE_EXCHANGE_DELIVERY_FEE=3000
SMARTSTORE_DEFAULT_STOCK=999
SMARTSTORE_AS_PHONE=0000-0000
SMARTSTORE_ORIGIN_AREA_CODE=0200037
SMARTSTORE_ORIGIN_CONTENT=미국

# --- 쿠팡 Wing Open API ---
# ACCESS/SECRET/VENDOR 미설정 시 스텁 등록
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=
COUPANG_DISPLAY_CATEGORY_CODE=
COUPANG_OUTBOUND_SHIPPING_PLACE_CODE=
COUPANG_RETURN_CENTER_CODE=
COUPANG_RETURN_CHARGE_NAME=
COUPANG_COMPANY_CONTACT_NUMBER=
COUPANG_VENDOR_USER_ID=
COUPANG_RETURN_CHARGE=2500
COUPANG_DELIVERY_CHARGE_TYPE=FREE
COUPANG_DEFAULT_QUANTITY=100
COUPANG_REQUESTED=false
COUPANG_NOTICE_CATEGORY=기타 재화

# --- 동기화 스케줄러 ---
# 프로덕션 cron 호출 시 필수. Authorization: Bearer <secret> 또는 x-cron-secret
CRON_SECRET=
SYNC_BATCH_LIMIT=50

# --- AI (Step 1+ 추천 이유/상세, Step 4 운영 비서, ① 발굴 이유) ---
# 미설정 시 템플릿 폴백 (규칙 점수·DB 수치는 코드가 담당)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- ① AI 상품 발굴 (Naver ↔ 1688, 기본 스텁) ---
DISCOVER_DEMAND_ADAPTER=naver
DISCOVER_SUPPLY_ADAPTER=1688
CNY_TO_KRW=190
DISCOVER_TARGET_MARGIN=0.35
DISCOVER_LANDED_MULTIPLIER=1.45

# --- 중국몰 자동주문 어댑터 (Step 2, 공식 API 없으면 스텁) ---
CHINA_MALL_ADAPTER=stub
CHINA_MALL_API_KEY=
CHINA_MALL_API_BASE=

# --- 배대지 / 송장 등록 (Step 3) ---
FORWARDER_ADAPTER=stub
FORWARDER_API_KEY=
FORWARDER_API_BASE=
