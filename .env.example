# Prisma Dev(로컬): `npm run db:dev` 후 출력된 URL을 사용
# Docker: postgresql://postgres:postgres@localhost:5432/sourcing_hub?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sourcing_hub?schema=public"

# 가격 규칙 기본값 (시드/폴백) — AI 추천 판매가 엔진
USD_TO_KRW=1380
MARGIN_RATE=0.20
MIN_MARGIN_RATE=0.05
SHIPPING_FEE_KRW=15000
# 중국/국제 배송을 분리하려면 아래를 설정 (없으면 SHIPPING_FEE_KRW를 국제배송으로 사용)
CHINA_SHIPPING_FEE_KRW=0
INTL_SHIPPING_FEE_KRW=15000
# 국제배송: table(더베이 항공 kg표, 기본) | flat(고정 INTL/SHIPPING)
FORWARDER_SHIPPING_MODE=table
THEBAY_AIR_TIER=seller
# 몰테일(미국): general | platinum · 유류할증 USD · 센터수수료(델라웨어 등, 기본 0)
MALLTAIL_TIER=general
MALLTAIL_FUEL_SURCHARGE_USD=1
MALLTAIL_CENTER_FEE_USD=0
# 무게 미입력 시 가정(g) — 중국 0.5kg / 미국 ~1lb 구간에 가깝게 500g
DEFAULT_SHIPPING_WEIGHT_G=500
AGENCY_FEE_KRW=3000
PLATFORM_FEE_RATE=0.10
CARD_FEE_RATE=0.025
DUTY_RATE=0.08
# 경쟁 평균 대비 목표 할인율 (추천가 클램프)
COMPETITOR_UNDERCUT_RATE=0.02
# 시장성 판정: 최소판매가 ≤ 경쟁평균 × MARKET_CEILING_RATE → 판매
MARKET_CEILING_RATE=1.15
# 합배송 가정 건수 (국제배송 N등분 시나리오)
SHIPPING_CONSOLIDATION_UNITS=5

# --- 스마트스토어 Commerce API ---
# CLIENT_ID/SECRET 미설정 시 스텁 등록
SMARTSTORE_CLIENT_ID=
SMARTSTORE_CLIENT_SECRET=
# SELF(기본, 본인 스토어) | SELLER(솔루션 — SMARTSTORE_ACCOUNT_ID 필요)
SMARTSTORE_TOKEN_TYPE=SELF
SMARTSTORE_ACCOUNT_ID=
# 상품 등록에 필요 (키만 있고 아래가 없으면 live 모드에서 실패 메시지 반환)
SMARTSTORE_LEAF_CATEGORY_ID=
SMARTSTORE_SHIPPING_ADDRESS_ID=
SMARTSTORE_RETURN_ADDRESS_ID=
SMARTSTORE_DELIVERY_ATTRIBUTE_TYPE=NORMAL
SMARTSTORE_DELIVERY_FEE_TYPE=FREE
SMARTSTORE_DELIVERY_FEE=0
SMARTSTORE_RETURN_DELIVERY_FEE=3000
SMARTSTORE_EXCHANGE_DELIVERY_FEE=3000
SMARTSTORE_DEFAULT_STOCK=999
SMARTSTORE_AS_PHONE=0000-0000
SMARTSTORE_ORIGIN_AREA_CODE=0200037
SMARTSTORE_ORIGIN_CONTENT=미국

# --- 쿠팡 Wing Open API ---
# ACCESS/SECRET/VENDOR 미설정 시 스텁 등록
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=
COUPANG_DISPLAY_CATEGORY_CODE=
COUPANG_OUTBOUND_SHIPPING_PLACE_CODE=
COUPANG_RETURN_CENTER_CODE=
COUPANG_RETURN_CHARGE_NAME=
COUPANG_COMPANY_CONTACT_NUMBER=
COUPANG_VENDOR_USER_ID=
COUPANG_RETURN_CHARGE=2500
COUPANG_DELIVERY_CHARGE_TYPE=FREE
COUPANG_DEFAULT_QUANTITY=100
COUPANG_REQUESTED=false
COUPANG_NOTICE_CATEGORY=기타 재화

# --- 동기화 스케줄러 ---
# 프로덕션 cron 호출 시 필수. Authorization: Bearer <secret> 또는 x-cron-secret
CRON_SECRET=
SYNC_BATCH_LIMIT=50

# --- AI (Gemini primary — 9ruTrip 과 동일 키 사용 가능) ---
# npm run ai:import-gemini 로 9ruTrip apps/api/.env 에서 가져올 수 있음
# 미설정 시 템플릿 폴백 (규칙 점수·DB 수치는 코드가 담당)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
AI_PROVIDER=gemini
# OPENAI_API_KEY=   # legacy, unused
# OPENAI_MODEL=gpt-4o-mini


# --- ① AI 상품 발굴 (Naver ↔ 1688) ---
DISCOVER_DEMAND_ADAPTER=naver
DISCOVER_SUPPLY_ADAPTER=1688
# auto(기본): NAVER_CLIENT_* 있으면 live / stub(강제 스텁) / live(키 필수)
DISCOVER_NAVER_MODE=auto
# 네이버 개발자 센터 오픈API (검색 → 쇼핑)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 네이버 검색광고 API (월간 검색량, 선택)
# ads.naver.com → 검색광고 → 도구 → SA API 사용 관리
NAVER_SEARCHAD_ACCESS_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=
CNY_TO_KRW=190
DISCOVER_TARGET_MARGIN=0.35
DISCOVER_LANDED_MULTIPLIER=1.45
# 주간 자동 발굴 (cron /api/cron/discover-weekly)
DISCOVER_WEEKLY_EXPAND_RELATED=false
DISCOVER_WEEKLY_MIN_SCORE=40
DISCOVER_WEEKLY_SUPPLY_LIMIT=1
DISCOVER_WEEKLY_DELAY_MS=300

# --- 중국몰 자동주문 어댑터 (Step 2, 공식 API 없으면 스텁) ---
CHINA_MALL_ADAPTER=stub
CHINA_MALL_API_KEY=
CHINA_MALL_API_BASE=

# --- 자동주문 파이프라인 (1688 → 장바구니 → 결제게이트 → 배대지) ---
# stub(기본) | live-hook (Playwright/API 자리, AUTO_ORDER_LIVE=true 필요)
AUTO_ORDER_ADAPTER=stub
AUTO_ORDER_LIVE=false
AUTO_ORDER_PLAYWRIGHT_ENABLED=false
AUTO_ORDER_STUB_DELAY_MS=40
# 배대지 수령지 (시크릿 아님 — 플레이스홀더)
FORWARDER_ADDRESS_NAME=
FORWARDER_ADDRESS_PHONE=
FORWARDER_ADDRESS_COUNTRY=CN
FORWARDER_ADDRESS_PROVINCE=
FORWARDER_ADDRESS_CITY=
FORWARDER_ADDRESS_DISTRICT=
FORWARDER_ADDRESS_LINE1=
FORWARDER_ADDRESS_LINE2=
FORWARDER_ADDRESS_POSTAL=

# --- 배대지 / 송장 등록 (Step 3) ---
# stub(기본, 키 없이 데모) | live (URL+KEY 필요 → HttpForwarderAdapter)
FORWARDER_ADAPTER=stub
FORWARDER_API_KEY=
FORWARDER_API_URL=
FORWARDER_API_BASE=

# --- 11번가 OpenAPI (송장 업로드 / 상품 스텁) ---
# 미설정 시 스텁. 설정 시 송장 live 스켈레톤 호출
ELEVENST_API_KEY=
ELEVENST_API_URL=
ELEVENST_OPENAPI_URL=
ELEVENST_SELLER_ID=
