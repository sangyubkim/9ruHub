// Sourcing Hub — SaaS-ready multi-tenant schema
// Phase 0: tenants + products/orders/shipments/AI foundations
// Preserve: SourceProduct → ProductDraft → ChannelListing / SyncJob

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum DraftStatus {
  DRAFT
  READY
  APPROVED
  PUBLISHING
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum SourceMall {
  AMAZON_US
  OTHER
}

enum Channel {
  SMARTSTORE
  COUPANG
}

enum ListingStatus {
  NOT_CREATED
  PENDING
  LIVE
  SUSPENDED
  FAILED
}

enum SyncJobType {
  PRICE
  STOCK
  FULL
}

enum SyncJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProductStatus {
  SOURCING
  DRAFTING
  LISTED
  ARCHIVED
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  IGNORED
  DRAFT_CREATED
  CONVERTED
}

enum OrderStatus {
  PENDING
  PURCHASE_REQUESTED
  PURCHASED
  SHIPPED_TO_FORWARDER
  IN_FORWARDER
  SHIPPED_TO_CUSTOMER
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PurchaseAttemptStatus {
  STUBBED
  QUEUED
  SUCCEEDED
  FAILED
}

enum ShipmentStatus {
  PENDING
  AT_FORWARDER
  IN_TRANSIT
  DELIVERED
  EXCEPTION
  CANCELLED
}

enum InvoiceRegisterStatus {
  NOT_REQUESTED
  STUBBED
  SUCCEEDED
  FAILED
}

enum ConversationRole {
  USER
  ASSISTANT
  SYSTEM
}

/// Demand-side mall for keyword discovery (① AI 상품 발굴)
enum DemandMall {
  NAVER
  COUPANG // extension stub only
}

/// Supply-side mall for cost discovery (① AI 상품 발굴)
enum SupplyMall {
  MALL_1688
  ALIEXPRESS // extension stub only
  TAOBAO // extension stub only
}

// ─── SaaS: Tenant / User ─────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           TenantMember[]
  priceRules        PriceRule[]
  sourceProducts    SourceProduct[]
  productDrafts     ProductDraft[]
  products          Product[]
  priceHistory      ProductPriceHistory[]
  orders            Order[]
  shipments         Shipment[]
  recommendations   AiRecommendation[]
  conversations     AiConversation[]
  productCandidates ProductCandidate[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships TenantMember[]

  @@map("users")
}

model TenantMember {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      MemberRole @default(MEMBER)
  createdAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_members")
}

// ─── Existing pricing / draft pipeline (tenant-scoped) ───

model PriceRule {
  id              String   @id @default(cuid())
  tenantId        String
  name            String   @default("default")
  usdToKrw        Decimal  @db.Decimal(12, 4)
  marginRate      Decimal  @db.Decimal(6, 4)
  shippingFeeKrw  Int      @default(15000)
  agencyFeeKrw    Int      @default(3000)
  platformFeeRate Decimal  @db.Decimal(6, 4) @default(0.10)
  dutyRate        Decimal  @db.Decimal(6, 4) @default(0.08)
  roundTo         Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model SourceProduct {
  id            String     @id @default(cuid())
  tenantId      String
  mall          SourceMall @default(AMAZON_US)
  sourceUrl     String
  externalId    String
  title         String
  brand         String?
  currency      String     @default("USD")
  sourcePrice   Decimal    @db.Decimal(12, 2)
  inStock       Boolean    @default(true)
  images        Json
  options       Json
  rawPayload    Json?
  fetchedAt     DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  drafts   ProductDraft[]
  products Product[]

  @@unique([tenantId, mall, externalId])
  @@index([tenantId, createdAt])
  @@index([sourceUrl])
}

model ProductDraft {
  id              String      @id @default(cuid())
  tenantId        String
  status          DraftStatus @default(DRAFT)
  sourceProductId String
  sourceProduct   SourceProduct @relation(fields: [sourceProductId], references: [id], onDelete: Cascade)

  titleKo         String
  detailHtml      String
  salePriceKrw    Int
  costBreakdown   Json
  images          Json
  options         Json
  noticeText      String
  categoryHint    String?
  isFallbackData  Boolean     @default(false)
  reviewNote      String?

  approvedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listings        ChannelListing[]
  syncJobs        SyncJob[]
  publishLogs     PublishLog[]
  products        Product[]
  recommendations AiRecommendation[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model ChannelListing {
  id                String        @id @default(cuid())
  draftId           String
  draft             ProductDraft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  channel           Channel
  status            ListingStatus @default(NOT_CREATED)
  externalProductId String?
  lastPayload       Json?
  lastError         String?
  lastSyncedAt      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([draftId, channel])
  @@index([channel, status])
}

model SyncJob {
  id         String        @id @default(cuid())
  draftId    String
  draft      ProductDraft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  type       SyncJobType
  status     SyncJobStatus @default(QUEUED)
  message    String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([status, createdAt])
}

model PublishLog {
  id        String   @id @default(cuid())
  draftId   String
  draft     ProductDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  channel   Channel
  success   Boolean
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([draftId, createdAt])
}

// ─── products + price history (canonical catalog) ────────

model Product {
  id              String        @id @default(cuid())
  tenantId        String
  sourceProductId String?
  draftId         String?
  sku             String?
  title           String
  titleKo         String?
  brand           String?
  status          ProductStatus @default(SOURCING)
  sourceMall      SourceMall    @default(AMAZON_US)
  sourceUrl       String?
  externalId      String?
  currency        String        @default("USD")
  sourcePrice     Decimal       @db.Decimal(12, 2)
  salePriceKrw    Int?
  costKrw         Int?
  stockQty        Int           @default(0)
  inStock         Boolean       @default(true)
  images          Json?
  // feedback hooks for ML / analytics
  totalSold       Int           @default(0)
  totalRevenueKrw Int           @default(0)
  totalProfitKrw  Int           @default(0)
  refundCount     Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceProduct   SourceProduct?         @relation(fields: [sourceProductId], references: [id], onDelete: SetNull)
  draft           ProductDraft?          @relation(fields: [draftId], references: [id], onDelete: SetNull)
  priceHistory    ProductPriceHistory[]
  orderItems      OrderItem[]
  recommendations AiRecommendation[]

  @@unique([tenantId, sourceMall, externalId])
  @@index([tenantId, status])
  @@index([tenantId, updatedAt])
  @@index([tenantId, createdAt])
  @@map("products")
}

model ProductPriceHistory {
  id           String   @id @default(cuid())
  tenantId     String
  productId    String
  sourcePrice  Decimal  @db.Decimal(12, 2)
  salePriceKrw Int?
  costKrw      Int?
  currency     String   @default("USD")
  inStock      Boolean?
  recordedAt   DateTime @default(now())
  note         String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, recordedAt])
  @@index([productId, recordedAt])
  @@map("product_price_history")
}

// ─── Orders ──────────────────────────────────────────────

model Order {
  id                 String      @id @default(cuid())
  tenantId           String
  channel            Channel?
  externalOrderId    String?
  status             OrderStatus @default(PENDING)
  customerName       String?
  customerPhone      String?
  shippingAddress    Json?
  currency           String      @default("KRW")
  subtotalKrw        Int         @default(0)
  shippingFeeKrw     Int         @default(0)
  platformFeeKrw     Int         @default(0)
  costKrw            Int         @default(0)
  profitKrw          Int         @default(0)
  refundedKrw        Int         @default(0)
  orderedAt          DateTime    @default(now())
  purchasedAt        DateTime?
  cancelledAt        DateTime?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  shipment Shipment?

  @@unique([tenantId, channel, externalOrderId])
  @@index([tenantId, status])
  @@index([tenantId, orderedAt])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productId        String?
  title            String
  quantity         Int     @default(1)
  unitSalePriceKrw Int
  unitCostKrw      Int     @default(0)
  lineProfitKrw    Int     @default(0)
  sourceUrl        String?
  // China mall purchase adapter fields
  purchaseMall     String?
  purchaseStatus   PurchaseAttemptStatus @default(STUBBED)
  purchaseRef      String?
  purchasePayload  Json?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ─── Shipments / forwarder ───────────────────────────────

model Shipment {
  id                    String                @id @default(cuid())
  tenantId              String
  orderId               String                @unique
  status                ShipmentStatus        @default(PENDING)
  forwarderCode         String? // e.g. STUB_FORWARDER
  forwarderTrackingNo   String?
  localCarrier          String?
  localTrackingNo       String?
  channelInvoiceStatus  InvoiceRegisterStatus @default(NOT_REQUESTED)
  channelInvoicePayload Json?
  weightGrams           Int?
  shippingCostKrw       Int                   @default(0)
  events                Json?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("shipments")
}

// ─── AI product discovery candidates (① Naver ↔ 1688) ───

model ProductCandidate {
  id                 String     @id @default(cuid())
  tenantId           String
  sourceDemandMall   DemandMall @default(NAVER)
  sourceSupplyMall   SupplyMall @default(MALL_1688)
  keyword            String
  title              String
  demandUrl          String?
  supplyUrl          String?
  externalDemandId   String?
  externalSupplyId   String?
  searchVolume       Int?
  competition        Decimal?   @db.Decimal(8, 4)
  reviewCount        Int?
  rating             Decimal?   @db.Decimal(4, 2)
  salesEstimate      Int?
  /// Supply cost in CNY (1688)
  costPrice          Decimal?   @db.Decimal(12, 2)
  /// Suggested KRW sell price
  sellPrice          Int?
  marginRate         Decimal?   @db.Decimal(8, 4)
  seasonalityScore   Decimal?   @db.Decimal(8, 4)
  currency           String     @default("CNY")
  isStub             Boolean    @default(true)
  rawMetrics         Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recommendations AiRecommendation[]

  @@unique([tenantId, sourceDemandMall, sourceSupplyMall, keyword, externalSupplyId], map: "product_candidates_tenant_malls_kw_supply_key")
  @@index([tenantId, keyword])
  @@index([tenantId, createdAt])
  @@map("product_candidates")
}

// ─── AI recommendations + conversations ─────────────────

model AiRecommendation {
  id              String               @id @default(cuid())
  tenantId        String
  productId       String?
  draftId         String?
  candidateId     String?
  sourceUrl       String?
  externalId      String?
  title           String
  score           Decimal              @db.Decimal(8, 4)
  scoreBreakdown  Json
  status          RecommendationStatus @default(PENDING)
  reasonCode      String?
  reasonText      String?
  detailHtml      String?
  // ML feedback loop
  acceptedAt      DateTime?
  ignoredAt       DateTime?
  convertedAt     DateTime?
  resultingSales  Int                  @default(0)
  resultingProfit Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  draft     ProductDraft?     @relation(fields: [draftId], references: [id], onDelete: SetNull)
  candidate ProductCandidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, score])
  @@index([productId])
  @@index([candidateId])
  @@map("ai_recommendations")
}

model AiConversation {
  id        String   @id @default(cuid())
  tenantId  String
  title     String?
  context   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages AiConversationMessage[]

  @@index([tenantId, createdAt])
  @@map("ai_conversations")
}

model AiConversationMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           ConversationRole
  content        String
  metricsSnapshot Json?
  createdAt      DateTime         @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_conversation_messages")
}
